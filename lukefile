luke_format = 0

package  = 'std.normalize'
version  = '$USER'

ldocs    = 'build-aux/config.ld.in'

modules  = {
   {['std.normalize']         = 'lib/std/normalize/init.lua'},
   {['std.normalize.version'] = 'lib/std/normalize/version.lua.in'},
}

-- `luke release version=X.Y` adds the release to NEWS.md, writes the
-- release rockspec, points the README badges at the release branch,
-- commits the LDocs, and publishes them to gh-pages.
release  = {
   news         = 'NEWS.md',
   rockspec     = 'std.normalize-dev-1.rockspec',
   add          = {'doc/'},
   replacements = {
      {['README.md'] = {
         {['?branch=master'] = '?branch=release-v@version@'},
      }},
   },
   ['gh-pages'] = {
      {['.'] = 'doc/'},
   },
}
