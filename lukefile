luke_format = 0

package  = 'std.normalize'
version  = '$USER'

ldocs    = 'build-aux/config.ld.in'

modules  = {
   {['std.normalize']         = 'lib/std/normalize/init.lua'},
   {['std.normalize._core']   = 'lib/std/normalize/_core.lua'},
   {['std.normalize.version'] = 'lib/std/normalize/version.lua.in'},
}

release  = {
   news               = 'NEWS.md',
   rockspec           = 'std.normalize-dev-1.rockspec',
   check_dependencies = true,
   add                = {'doc/'},
   replacements       = {
      {['README.md']  = {
         {['?branch=master'] = '?branch=release-v@version@'},
      }},
   },
   ['gh-pages']       = {
      {['.'] = 'doc/'},
   },
}
